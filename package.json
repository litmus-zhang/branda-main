{
  "private": true,
  "name": "branda",
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "shiki": "4.0.2"
    }
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "nx": "22.6.5"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx patch-package",
    "dev": "nx run-many -t dev ",
    "dev:web": "nx run-many -t dev --exclude=server,transactional,infra",
    "dev:api": "nx run-many -t dev --exclude=web,transactional,infra",
    "dev:transactional": "nx run-many -t dev --exclude=web,server,infra",
    "build": "nx run build",
    "start:api": "nx run -t",
    "start:client": "nx run client#start --env-mode=loose",
    "build:api": "nx run api#build --env-mode=loose",
    "build:client": "nx run client#build --env-mode=loose",
    "test:api": "pnpm --filter api run test:e2e",
    "test:api:ci": "pnpm --filter api run test:ci",
    "test:client": "pnpm --filter client run test:e2e",
    "format": "nx run format",
    "lint": "nx run lint",
    "client:check:types": "pnpm --filter client run check:types",
    "client:lint": "pnpm --filter client run lint",
    "client:validate": "pnpm run client:check:types && pnpm run client:lint",
    "prepare": "husky install"
  }
}