{
  "private": true,
  "name": "branda-app",
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    }
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "husky": "^9.1.6"

  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx patch-package",

    "dev": "turbo run dev",
    "build": "turbo run build",

		"start:api": "turbo run api#start --env-mode=loose",
		"start:client": "turbo run client#start --env-mode=loose",

		"dev:api": "turbo run api#dev --env-mode=loose",
		"dev:client": "turbo run client#dev --env-mode=loose",

    
		"build:api": "turbo run api#build --env-mode=loose",
		"build:client": "turbo run client#build --env-mode=loose",

    "db:init": "pnpm --filter=api run db:init",
    "db:admin": "pnpm --filter=api run db:admin",
    "db:migrate": "pnpm --filter=api run db:migrate",

    "format": "turbo run format",
    "lint": "turbo run lint",

    "codegen": "turbo run codegen",
    "generate:oas": "turbo run generate:oas",
    "prepare": "husky"

  }
}