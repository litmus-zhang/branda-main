{
  "private": true,
  "name": "branda",
  "version": "0.1.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "shiki": "4.0.2",
      "csstype": "3.2.3",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "next": "16.0.10"
    },
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "nx": "22.6.5"
  },
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:web": "nx run-many -t dev --exclude=server,transactional",
    "dev:api": "nx run server:dev",
    "dev:email": "nx run transactional:dev",
    "build:api": "nx run server:build",
    "build:admin": "nx run admin:build",
    "build:web": "nx run web:build",
    "start:api": "nx run server:start",
    "start:admin": "nx run admin:start",
    "start:web": "nx run web:start",
    "format": "nx run format",
    "lint": "nx run lint",
    "client:check:types": "pnpm --filter client run check:types",
    "client:lint": "pnpm --filter client run lint",
    "client:validate": "pnpm run client:check:types && pnpm run client:lint"
  }
}