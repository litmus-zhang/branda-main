{
  "extends": "@branda/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "./components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@branda/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/ui/src/lib/events.ts",
    "../../packages/ui/src/components/event-card.tsx",
    "../../packages/ui/src/components/ui/layout.tsx",
    "../../packages/ui/src/components/forms/user-onboarding.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}